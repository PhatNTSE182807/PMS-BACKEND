<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings for dotnet test. See tests/README.md for the command. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Measure only the PMS assemblies, never the test projects themselves. -->
          <Include>[PMS.*]*</Include>
          <Exclude>[PMS.*Tests]*</Exclude>
          <!-- EF Core migrations and generated code are not worth covering. -->
          <ExcludeByFile>**/Migrations/*.cs,**/obj/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
